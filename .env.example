# Copy to .env for local development. Never commit .env.
SECRET_KEY=change-me-to-48-random-characters
DATABASE_URL=sqlite:///tylonerp.db
# Set to 0 only for local http development
COOKIE_SECURE=0
ADMIN_EMAIL=admin@erp.co.zw
ADMIN_PASSWORD=change-me
# ENV=production
# LOGIN_RATE_LIMIT=10 per minute
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# EcoCash: each tenant enters its own merchant account under Payments in its workspace.
# Platform-wide endpoint settings (optional):
# ECOCASH_BASE_URL=https://developers.ecocash.co.zw/sandbox/payment/v1   # use the production URL after go-live
# ECOCASH_CHARGE_PATH=/transactions/amount
# ECOCASH_CURRENCY=USD
