# Create .gitignore
cat > .gitignore << 'EOF'
# Environment variables
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Flask
instance/
.webassets-cache

# Database
*.db
*.sqlite
*.sqlite3
instance/

# Logs
logs/
*.log
*.log.*

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Cache
.cache/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Uploads
uploads/
tmp/
temp/

# OS
.DS_Store
Thumbs.db

# Node (if using React frontend)
node_modules/
npm-debug.log
yarn-error.log

# Test coverage
.coverage
coverage.xml
EOF
